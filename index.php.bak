        <!-- ════════════ MODAL: CONFIRMAR EXCLUSÃO ════════════ -->
        <div class="modal-overlay" id="modalConfirmarExcluirSessao" style="display:none">
          <div class="modal" style="max-width:400px">
            <div class="modal-header">
              <span class="modal-title">Excluir Sessão</span>
